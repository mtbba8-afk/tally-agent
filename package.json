{
  "name": "tally-agent",
  "private": true,
  "version": "0.1.0",
  "description": "Tally: a human-in-the-loop invoicing and payment agent for small service businesses.",
  "workspaces": [
    "apps/*",
    "skills/*"
  ],
  "scripts": {
    "test": "vitest run && npm run test:contract",
    "test:watch": "vitest",
    "test:contract": "cargo test --manifest-path contracts/tally-office/Cargo.toml",
    "build:contract": "cargo build --manifest-path contracts/tally-office/Cargo.toml --target wasm32-unknown-unknown --release",
    "office:demo": "vitest run skills/front_office/src/demo.test.ts && cat benchmarks/demo-transcript.txt",
    "dev": "npm run dev --workspace @tounkara/tally",
    "build": "npm run build --workspace @tounkara/tally",
    "lint": "npm run lint --workspace @tounkara/tally",
    "demo:loop": "vitest run skills/payment_links/src/loop.test.ts skills/reconciliation/src/index.test.ts"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
