# Copy to .env.local in apps/tally. Leave a value blank to use the fallback described below.
# Never commit filled-in secrets.

# PayPal sandbox REST app from https://developer.paypal.com/dashboard/applications
# Blank: mock gateway. The pay page records payment locally.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Sandbox webhook id. Required before PayPal can POST to /api/webhooks/paypal.
PAYPAL_WEBHOOK_ID=

# Vercel AI Gateway key. Blank: price-book drafts and a small fixed question set.
# On Vercel, OIDC can stand in for this key.
AI_GATEWAY_API_KEY=
AI_MODEL=openai/gpt-5.4-mini

# Supabase ledger. When both are set, Tally uses Postgres instead of the local JSON file.
# On Vercel this is required. The app filesystem, including /tmp, does not keep the ledger.
# SUPABASE_URL is preferred. NEXT_PUBLIC_SUPABASE_URL is accepted as an alias.
# The service role stays on the server. Do not prefix that key with NEXT_PUBLIC_.
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Bearer token Vercel Cron sends to /api/cron/reminders. Required when VERCEL=1.
CRON_SECRET=

# Public origin for links inside reminder copy. Example: https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=

# Optional path for the JSON ledger.
TALLY_DATA_PATH=

# --- Tally Front Office (NEAR). Leave blank. Never commit filled-in secrets. ---

# local (default) prices the voice note on the shop price book.
# cloud calls NEAR AI Cloud at https://cloud-api.near.ai/v1 when NEAR_AI_API_KEY is set.
NEAR_AI_MODE=local
NEAR_AI_API_KEY=
NEAR_AI_MODEL=zai-org/GLM-5.1-FP8

# mock (default) does not call the network and does not create a deposit address.
# dry calls the 1Click quote API with dry:true. NEAR Intents has no testnet.
# NEAR_INTENTS_EXECUTE is refused. This build does not broadcast a deposit.
NEAR_INTENTS_MODE=mock
NEAR_INTENTS_JWT=
NEAR_INTENTS_EXECUTE=

# mock (default). tee requires SHADE_AGENT_MEASUREMENT and still does not broadcast.
SHADE_AGENT_MODE=mock
SHADE_AGENT_MEASUREMENT=

# Chain signatures are built for v1.signer-prod.testnet and are not broadcast.
# A funded testnet key would live in the shell, never in this file's committed copy.
NEAR_CHAIN_SIG_MODE=mock
NEAR_ACCOUNT_ID=
NEAR_PRIVATE_KEY=
