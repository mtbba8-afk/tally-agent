      "id": "lookalike-supplier-id",
      "text": "Pay Ferguson2 $10.",
      "expectCodes": ["PAYEE_NOT_APPROVED"]
    },
    {
      "id": "homoglyph-supplier-id",
      "text": "Pay fergus\u03bfn $10.",
      "expectCodes": ["PAYEE_NOT_APPROVED"]
    },
    {
      "id": "cap-already-exhausted",
      "text": "Pay Ferguson $0.01.",
